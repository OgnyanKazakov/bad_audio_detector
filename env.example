# Bad Audio Detector - example environment settings.
# Copy to .env and adjust as needed: cp .env.example .env

# --- General ---
APP_MODE=dev
INGEST_MODE=file
RTP_DECODE=true

# --- Detection / DSP ---
TARGET_SAMPLE_RATE=16000
WINDOW_SECONDS=1.0
HOP_SECONDS=0.5
DECISION_THRESHOLD=0.5
# THRESHOLD_OVERRIDE=
CONSECUTIVE_WINDOWS=2
MIN_ACTIVITY_SECONDS=0.5
VAD_THRESHOLD=0.02

# --- Model paths ---
MODEL_PATH=models/current/detector.joblib
MODELS_DIR=models
THRESHOLD_PATH=models/current/threshold.json

# --- Retraining data ---
GOOD_RECORDS_DIR=data/records/good
BAD_RECORDS_DIR=data/records/bad
RECORDS_RECURSIVE=true
REAL_EVAL_FRACTION=0.2
REAL_DATA_WEIGHT=1.0
MIN_RECALL=0.98
MIN_PRECISION=0.85

# --- API / streaming ---
ADMIN_TOKEN=
JITTER_BUFFER_MS=200
MAX_FRAMES_PER_PACKET=10
# PAYLOAD_TYPE_MAP={"96":"AMR-WB"}
MAX_UPLOAD_MB=50
